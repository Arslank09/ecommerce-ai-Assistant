# Copy to ".env" and add your key. NEVER commit the real .env.

# FREE: Groq (get a key at https://console.groq.com)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Offline alternative: Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Store backend that exposes GET /products
GOSELLR_API_URL=http://localhost:3002
